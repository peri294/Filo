# Postgres en Neon (proyecto "Filo"): conexión directa (sin "-pooler" en el host) de cada rama.
# DATABASE_URL: rama `dev`. TEST_DATABASE_URL: rama `test`, que los tests vacían en cada corrida.
# En Vercel: DATABASE_URL es la de `production` con pooler y DATABASE_URL_UNPOOLED la directa (para migrar).
DATABASE_URL="postgresql://usuario:clave@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"
TEST_DATABASE_URL="postgresql://usuario:clave@ep-yyy.sa-east-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

# URL pública del sitio (links y, más adelante, Mercado Pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Nombre de la plataforma (no de una barbería)
NEXT_PUBLIC_BRAND_NAME="Turnos Barbería"

# Superadmin (dueño del sistema). El seed lo crea con estos datos; después la clave se cambia
# con "Olvidé mi contraseña" en /panel. Usá un celular real tuyo y una clave fuerte.
SUPERADMIN_PHONE="11 2345 6789"
SUPERADMIN_PASSWORD="cambiar-por-una-clave-fuerte"

# SMS (códigos de registro y recuperación). Sin estas variables, fuera de producción el código
# se muestra en la consola del servidor.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
# Tope de SMS por día en todo el sistema (freno al fraude de "bombeo" de SMS)
OTP_DAILY_CAP="500"

# Mercado Pago (etapa siguiente)
MP_ACCESS_TOKEN=""
