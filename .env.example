# Base de datos local (SQLite). Para producción en Vercel pasar a Postgres/Turso.
DATABASE_URL="file:./dev.db"

# URL pública del sitio (se usa en links y, más adelante, en Mercado Pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Panel del barbero (/admin)
ADMIN_PASSWORD="cambiar-esta-clave"
# Secreto para firmar la cookie de sesión del admin (cualquier texto largo y aleatorio)
ADMIN_SESSION_SECRET="dev-secret-cambiar-en-produccion-0123456789abcdef"

# Mercado Pago (etapa siguiente)
MP_ACCESS_TOKEN=""
