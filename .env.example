# URL pública del sitio (se usa en links y, más adelante, en Mercado Pago)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Panel del barbero (/admin). En producción: mínimo 10 caracteres y distinta a esta.
ADMIN_PASSWORD="cambiar-esta-clave"

# Mercado Pago (etapa siguiente)
MP_ACCESS_TOKEN=""
